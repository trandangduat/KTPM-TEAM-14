    "/api/v1/products": {
      "get": {
        "tags": [
          "Flash Sale"
        ],
        "summary": "Danh sach san pham Flash Sale",
        "description": "Xem danh sach cac san pham dang mo ban flash sale.\n\nPublic endpoint. Only ACTIVE products are loaded before applying filters.",
        "operationId": "list_products_api_v1_products_get",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Keyword"
            },
            "description": "Optional case-insensitive substring in product name or description; maximum 100 characters."
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Price"
            },
            "description": "Inclusive filter on flash_sale_price; value must be non-negative and minimum cannot exceed maximum."
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Price"
            },
            "description": "Inclusive filter on flash_sale_price; value must be non-negative and minimum cannot exceed maximum."
          },
          {
            "name": "in_stock_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "In Stock Only"
            },
            "description": "When true, return only products with stock greater than zero."
          },
          {
            "name": "sale_state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "UPCOMING",
                    "AVAILABLE",
                    "SOLD_OUT",
                    "ENDED",
                    "INACTIVE"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sale State"
            },
            "description": "Derived state filter. The repository lists ACTIVE products only, so INACTIVE returns no products."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductResponse"
                  },
                  "title": "Response List Products Api V1 Products Get"
                }
              }
            }
          },
          "422": {
            "description": "Request validation error (path, query, or body).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid price range or sale_state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Flash Sale"
        ],
        "summary": "Them san pham Flash Sale",
        "description": "Admin them moi mot san pham vao danh sach flash sale.\n\nRequires a valid bearer token and role ADMIN.",
