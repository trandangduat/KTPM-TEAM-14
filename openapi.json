      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Danh sach don hang",
        "description": "Xem danh sach don hang cua nguoi dung dang dang nhap.\n\nRequires a valid bearer token. Returns only the authenticated user’s orders, ordered newest first.",
        "operationId": "list_orders_api_v1_orders_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "PENDING",
                    "CONFIRMED",
                    "COMPLETED",
                    "CANCELLED"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            },
            "description": "Optional case-insensitive order status filter."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            },
            "description": "Number of user orders to skip; must be non-negative."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            },
            "description": "Maximum results; must be between 1 and 100."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderResponse"
                  },
                  "title": "Response List Orders Api V1 Orders Get"
                }
              }
            }
          },
          "422": {
            "description": "Request validation error (path, query, or body).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Invalid status filter or pagination values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                }
              }
            }
