    "/api/v1/orders/{order_id}/cancel": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Huy don hang",
        "description": "Huy don hang va hoan lai so luong vao ton kho.\n\nRequires a valid bearer token; only the order owner can cancel a PENDING order. CANCELLED is committed before stock is restored.",
        "operationId": "cancel_order_api_v1_orders__order_id__cancel_post",
        "security": [
